# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables — copy to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="ShopWave E-Commerce API"
DEBUG=false

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — matches docker-compose service name 'db'
DATABASE_URL=postgresql+asyncpg://shopwave:shopwave_pass@db:5432/shopwave_db

# CORS — comma-separated or JSON list
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
